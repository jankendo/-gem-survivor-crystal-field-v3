[gd_scene format=3]

[node name="RunSetup" type="PanelContainer"]
mouse_filter = 0

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_bottom = 12

[node name="Layout" type="VBoxContainer" parent="Margin"]

[node name="Title" type="Label" parent="Margin/Layout"]
text = "ランの準備"
autowrap_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout"]
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Body" type="VBoxContainer" parent="Margin/Layout/Scroll"]
size_flags_horizontal = 3

[node name="Info" type="Label" parent="Margin/Layout/Scroll/Body"]
autowrap_mode = 2
text = ""

[node name="Seed" type="LineEdit" parent="Margin/Layout/Scroll/Body"]
custom_minimum_size = Vector2(0,48)
placeholder_text = "シード（空欄で自動生成）"
max_length = 10
virtual_keyboard_type = 2

[node name="SeedHelp" type="Label" parent="Margin/Layout/Scroll/Body"]
autowrap_mode = 2
text = "1〜2147483647。コピーしたシードで同じ迷宮を再現できます。"

[node name="Reason" type="Label" parent="Margin/Layout"]
autowrap_mode = 2
theme_override_font_sizes/font_size = 16

[node name="Actions" type="GridContainer" parent="Margin/Layout"]
columns = 2

[node name="Start" type="Button" parent="Margin/Layout/Actions"]
custom_minimum_size = Vector2(0,48)
size_flags_horizontal = 3
clip_text = true
text = "このビルドで出発"

[node name="Back" type="Button" parent="Margin/Layout/Actions"]
custom_minimum_size = Vector2(0,48)
size_flags_horizontal = 3
clip_text = true
text = "戻る"
